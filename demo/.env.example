# demo 本地配置模板。首次使用：
#   cp demo/.env.example demo/.env
# 然后在 demo/.env 里填入真实的 Neo4j 密码（demo/.env 已被 .gitignore 忽略，不入库）。

# Neo4j（campus-neo4j 容器，Bolt 端口对外映射 7688）
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# 以下为 demo 默认值，一般无需改动（本机 Ollama 离线推理）。
