# ============================================================
# 【已废弃 / 可选】把 campus-wall-ai（原 GraphRAG 已并入）设为开机自启的 systemd 服务
#
# 推荐改用 campus-wall-ops 的 docker-compose 服务 ai-api（已 restart=unless-stopped 自启）。
# 仅当坚持 host 直跑（非容器）时才需要本 unit；它经 demo/run-graphrag.sh 起 campus-wall-ai(:8011)。
#
# 安装：
#   sudo cp deploy/server/campus-graphrag.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now campus-graphrag
# 查看：
#   systemctl status campus-graphrag
#   journalctl -u campus-graphrag -f
#
# 前提：已 cp demo/.env.example demo/.env 并填好 NEO4J_PASSWORD。
# ============================================================
[Unit]
Description=Campus Wall AI service (campus-wall-ai，原 GraphRAG 已并入)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=exec
User=nvidia
WorkingDirectory=/home/nvidia/Desktop/campus-wall
ExecStart=/usr/bin/env bash /home/nvidia/Desktop/campus-wall/demo/run-graphrag.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
