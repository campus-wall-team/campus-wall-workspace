# ============================================================
# ⚠️ 已弃用（DEPRECATED）：本 .env 模板保留仅作参考。
#   Spring Boot 默认不读取 campus_wall/.env，此路径从未真正生效。
#   团队后端本地配置请改用 YAML 方案：
#     · 模板：campus_wall/application-local.yaml.example
#     · 复制为 campus_wall/application-local.yaml 填真实值，或由管理员
#       `bash deploy/server/export-team-env.sh [B机IP]` 一键生成已填好的 YAML 分发。
#   生效机制：application.yaml 已配 spring.profiles.group.dev=local。
# ============================================================
# Campus Wall 后端 — 团队内网开发配置模板（旧 env 版，仅参考）
#
# 用法：复制本文件为 campus_wall/.env，再填入真实密钥
#   cp deploy/team-dev/backend.env.example campus_wall/.env
# 真实密钥（MySQL/Redis/MinIO 等）向【服务器管理员】索取；
# 管理员可用 deploy/server/export-team-env.sh 一键生成已填好的版本。
#
# 中间件服务器（GB10）局域网 IP：172.21.160.212
#   —— 若服务器 IP 变了，把下面所有 172.21.160.212 改成新 IP 即可。
# ============================================================

SPRING_PROFILES_ACTIVE=dev

# --- MySQL（⚠️ characterEncoding 用 utf8，不要写 utf8mb4，否则启动报错）---
MYSQL_URL=jdbc:mysql://172.21.160.212:3306/campus_wall?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
MYSQL_USER=root
MYSQL_PASSWORD=<向管理员索取>

# --- Redis ---
REDIS_HOST=172.21.160.212
REDIS_PORT=6379
REDIS_PASSWORD=<向管理员索取，可能为空>
REDIS_DB=0

# --- campus-wall-ai（原 graphrag 已并入；AI 学长问答引擎，已跑在服务器上）---
GRAPHRAG_BASE_URL=http://172.21.160.212:8011
GRAPHRAG_TIMEOUT_MS=120000

# --- MinIO（对象存储，文件/图片上传用；不传文件可暂留占位）---
MINIO_ENDPOINT=http://172.21.160.212:9000
MINIO_ACCESS_KEY=<向管理员索取>
MINIO_SECRET_KEY=<向管理员索取>
MINIO_BUCKET=campus-wall

# --- DashScope（仅非 GraphRAG 的云端 AI 功能需要；demo 主链路不依赖，可留占位）---
DASHSCOPE_API_KEY=<可选，向管理员索取>
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
LLM_MODEL=qwen-plus

# --- 微信登录（小程序真机登录需要；本地调试可用管理员登录代替）---
WX_APPID=<可选>
WX_SECRET=<可选>

# --- 管理端登录（用于拿 JWT 调试，如审核后台 / AI 接口联调）---
ADMIN_USER=admin
ADMIN_PASS=<向管理员索取>
ADMIN_USER_ID=1
